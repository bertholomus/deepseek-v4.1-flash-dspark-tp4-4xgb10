# DeepSeek-V4.1-Flash on 4× DGX Spark — TP4 production profile
# BertholomusAI recipe — profile values as of v1.1.6 (2026-09-14).
# Derived from .env.tp4.example (upstream repo commit e59e6eb); deviations marked  # <-- A1A4
#
# PROVENANCE: this file is a value-for-value equivalent of the live file
# (verified 2026-09-13, docs/PROVENANCE-AUDIT.md); comments differ, values do not.
# The frozen snapshot env.tp4.as-deployed-20260913 is likewise value-identical to
# what production ran that day.

HEAD_IP=10.0.0.1                                  # <-- A1A4 head fabric address
WORKER_IPS="10.0.0.2 10.0.0.3 10.0.0.4"     # <-- A1A4: spark2/03/04
WORKER_HOSTS="spark2 spark3 spark4"
WORKER_USER=<user>
SSH_IDENTITY=$HOME/.ssh/id_ed25519

FABRIC_IFACE=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0
NCCL_SOCKET_IFNAME=enp1s0f0np0
IB_HCA=mlx5_0,mlx5_2                                  # <-- A1A4: only these ports are PORT_ACTIVE
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
NCCL_DEBUG=WARN
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
NCCL_DEBUG_SUBSYS=INIT,ENV
# NCCL_HOST_DIR: not vendored in repo; image ships NCCL 2.28.3 (docs gap #3).
NCCL_HOST_DIR=

MODEL_DIR=/home/<user>/ai/models/DeepSeek-V4.1-Flash--dba1be0a   # <-- A1A4 local snapshot
COMMON_MODEL=/var/tmp/DeepSeek-V4.1-Flash--a1a4-tp4
BASE_IMAGE=lmsysorg/sglang:dev-dsv41
IMAGE=dsv41-4x-spark:local
PORT=8000                                             # <-- A1A4: keep clients unchanged (was 8888)

NFS_SHARE=0                      # A1 already runs a NFSv4 exporter (ganesha: /export-dsv41)
NFS_VOLUME=deepseek-v41-a1-nfs   # reuse the existing worker NFS volume (ro, addr=10.0.0.1)
NFS_EXPORT_NAME=dsv41-native
NFS_SERVER_IPS="10.0.0.1"
NFS_CLIENTS=10.0.0.2,10.0.0.3,10.0.0.4

NNODES=4
TP_SIZE=4
EP_SIZE=2                        # <-- A1A4: fitted to per-node memory headroom (example: 4)
DIST_PORT=20000

OFFLOAD_MODE=nvme
DSV41_CACHE_GIB=4              # <-- A1A4: 12 GiB REJECTED 2026-09-12 (head host-RAM exhaustion ~90s into weight load). 4 is the fitted value. (example: 0)
DSV41_IO_THREADS=96
DSV41_RESIDENT_SCALES=0
DSV41_CACHE_WAYS=16              # <-- A1A4 (example: 4). engram hit rate 74% aggregate
DSV41_STATS_SECONDS=60
CONTEXT_LENGTH=1048576
MEM_FRACTION_STATIC=0.90
HEAD_MEM_FRACTION_STATIC=0.90
MAX_RUNNING_REQUESTS=8
CHUNKED_PREFILL_SIZE=4096
MAX_TOTAL_TOKENS=8000000         # <-- A1A4 2026-09-13: 4M->8M (covers 8 concurrent 1M sessions). Measured speed-neutral; rollback 4000000.
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=2              # <-- A1A4: PRODUCTION 2026-09-14, gamma=2 (verify window 3) adopted from the fair-go window; +6-12% at fleet depth vs gamma-3. See docs/WINDOW-FAIRGO.md. Rollback: 3, then 5 (stock). (example: 5)
DSPARK_SPS_TABLE=/state/dspark_sps.json
DSPARK_STS_TABLE=/state/dspark_sts.json

ENGRAM_DIR=$HOME/dsv41-engram
DSV41_PACKED_DIR=/engram
SKIP_PREPARE=1
SKIP_VERIFY=1
SKIP_SMOKE=0
SMOKE_QUICK=1

EXTRA_SGLANG_ARGS="--fp8-gemm-backend flashinfer_cutlass --speculative-dspark-align-verify-tokens-to-graph-tier --watchdog-timeout 1800 --min-free-slots-delay 1 --enable-deepseek-v4-fp4-indexer --enable-metrics --enable-metrics-for-all-schedulers --enable-mixed-chunk"
                                 # <-- A1A4: last three example args added on top of upstream.
                                 #     --enable-metrics[/-for-all-schedulers]: durable-fix 2026-09-12; 447 sglang:* series on /metrics.
                                 #     --enable-mixed-chunk:  kept winner of 2026-09-12 (interleave witness; warm plateau 113.34).
                                 #     Rollback of the three: remove them; no other interaction measured.
DSV41_MXFP8_BACKEND=b12x
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192
DSV41_TP_PAD=0
WORKER_DIR=/home/<user>/dsv41-4x-spark
WORKER_ENGRAM_DIR=$HOME/dsv41-engram   # <-- A1A4: A4 home is a symlink -> xfs loop (docker resolves symlinks)

# --- DSpark experiment/instrumentation variables (production values) ---------
# These ONLY reach the containers because start.sh forwards them explicitly
# (patches/0002-dspark-env-passthrough.diff). Without that patch a variable set
# here is a silent no-op - this is the single most expensive trap of the
# 2026-09-13 window. Values below are the production ones.
SGLANG_DSPARK_FOLDED_PROPOSAL=1        # production: folded proposal ON (~9% faster than off; EVIDENCE §10)
SGLANG_DSPARK_BLOCK_ACCEPT_ONLINE_INTERVAL=60   # block-accept estimator; inert while folded proposal is ON
SGLANG_DSPARK_ENABLE_SPS_RECORD=0      # SPS table capture: profiling boots only (hangs graph capture under multi-node DSpark)
SGLANG_SIMULATE_ACC_LEN=-1             # engine default; 1.0 = profiler boot (hung warm-up 2026-09-12)
# Rollback of any of the four: set the engine default (1 / 0 / 0 / -1) and restart.

# Version pinning / rollback chain (backups kept alongside the live file):
#   .pre-gamma3-*  keeps gamma-4   |  .pre-gamma4-*  keeps gamma-5 (stock)
#   .pre-pr7-*     pre-tuning      |  .pre-capaccept2-* pre-cap-accept-trial
# Rule: every .env edit gets a timestamped backup first. Never edit without one.
